# Copy to backend/.env for local runs (uvicorn). Never commit .env.
APP_ENV=local
LOG_LEVEL=DEBUG
LOG_FORMAT=text
AWS_REGION=ap-south-1
ITEMS_TABLE_NAME=myapp-local-items
DYNAMODB_ENDPOINT_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173
# Dummy creds for DynamoDB Local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
